# Configuración de la API
API_BASE_URL=http://localhost:8000/api

# Configuración de entorno
NODE_ENV=development

# Configuración de Expo (opcional)
# EXPO_PROJECT_ID=tu-project-id-aqui

# Notas:
# - Copia este archivo como .env para desarrollo local
# - NO subas el archivo .env al repositorio (ya está en .gitignore)
# - Para producción, cambia API_BASE_URL a la URL de tu servidor
